FACE_SERVER_URL=http://10.150.12.148:5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bunny_door

# CORS — allowlist (comma-separated) สำหรับ cross-origin AJAX
# ปล่อยว่าง = อนุญาตเฉพาะ same-host + localhost
CORS_ORIGINS=

# DEV bypass login — default ON (ระบบช่วงพัฒนา ยังไม่ต้องมี login)
# ก่อน deploy production: ตั้ง DEV_BYPASS_LOGIN=0 เพื่อเปิดระบบ login
# DEV_BYPASS_LOGIN=0
